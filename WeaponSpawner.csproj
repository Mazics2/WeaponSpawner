<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AssemblyName>WeaponSpawner</AssemblyName>
    <RootNamespace>WeaponSpawner</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- SwiftlyS2, sunucu tarafinda calisma zamaninda saglanir -->
    <PackageReference Include="SwiftlyS2.CS2" Version="1.5.0" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>

